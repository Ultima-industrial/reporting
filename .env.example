# Copy this file to .env and fill in real values. Never commit .env.

# --- Odoo (accounting/invoicing + bank feed) ---
# Base URL of the Odoo instance, e.g. https://ultima-industrial.odoo.com
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
# API key generated under Odoo user preferences > Account Security > API Keys
# (requires a plan with XML-RPC/JSON-RPC external API access, e.g. Custom)
ODOO_API_KEY=
# The id of the bank journal (Accounting > Configuration > Journals) that
# holds the live BluBanca feed. Run scripts/list_odoo_bank_journals.py once
# ODOO_* above is set to find it.
ODOO_BANK_JOURNAL_ID=

# --- Google Sheets output ---
# Path to a Google service account JSON key file (share the target sheet with its client_email)
GOOGLE_SERVICE_ACCOUNT_FILE=./google-service-account.json
GOOGLE_SHEET_ID=

# --- Pipeline settings ---
CURRENCY=EUR
# How many days back to look on the very first run (subsequent runs continue from the sheet)
INITIAL_LOOKBACK_DAYS=90
# Seeds the Register's running balance on the very first run only (the real
# BluBanca balance as of this date). Not needed once the sheet has rows.
STARTING_BALANCE_AMOUNT=
STARTING_BALANCE_DATE=

# --- Netlify (dashboard website only, main_dashboard.py) ---
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
